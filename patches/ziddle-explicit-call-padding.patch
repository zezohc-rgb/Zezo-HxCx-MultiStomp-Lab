+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ir::{Branch, RegisterWrite};
+
+    fn explicit_branch() -> Vec<IrPacket> {
+        let mut packets: Vec<IrPacket> = (0..=24)
+            .step_by(4)
+            .map(|pc| IrPacket {
+                pc,
+                next_pc: pc + 4,
+                idle: 0,
+                writes: Vec::new(),
+                branches: Vec::new(),
+            })
+            .collect();
+        packets[0].branches.push(Branch {
+            predicate: None,
+            taken_when_nonnegative: None,
+            target: BranchTarget::Static(0x100),
+            issued_pc: 0,
+            delay: 5,
+            call_link: None,
+        });
+        packets[1].writes.push(RegisterWrite {
+            predicate: None,
+            destination: Reg::b(3),
+            delay: 0,
+            constant: Some(24),
+        });
+        packets[2].idle = 3;
+        packets
+    }
+
+    #[test]
+    fn explicit_call_can_return_past_idle_padding() {
+        let mut packets = explicit_branch();
+        link_explicit_calls(&mut packets, &BTreeSet::from([12, 16, 20]));
+        assert_eq!(
+            packets[0].branches[0].call_link,
+            Some(CallLink {
+                destination: Reg::b(3),
+                return_pc: 24,
+            }),
+        );
+    }
+
+    #[test]
+    fn explicit_call_does_not_skip_a_non_idle_packet() {
+        let mut packets = explicit_branch();
+        link_explicit_calls(&mut packets, &BTreeSet::from([12, 20]));
+        assert_eq!(packets[0].branches[0].call_link, None);
+    }
+}
