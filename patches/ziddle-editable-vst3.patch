+use crate::package::{admit_prepared, Occurrence, PackageDiscovery, PlayableEffect};
+use crate::rack_state::{package_for_state_effect, EffectState, RackState};
+use std::path::{Path, PathBuf};
+use ziddle_documents::{ImplementationRef, SlotId};
+use ziddle_native_module::{host_target, MODULE_ABI};
+
+pub const SLOT_COUNT: usize = 6;
+
+pub fn enabled() -> bool {
+    matches!(crate::bundle::installed(), Some(Ok(bundle)) if bundle.editable())
+}
+
+pub fn empty_slot(index: usize) -> EffectState {
+    EffectState {
+        binary_sha256: None,
+        enabled: false,
+        values: Vec::new(),
+        slot_id: SlotId::new(index as u128 + 1),
+        selection: None,
+    }
+}
+
+pub(crate) fn admit(mut rack: RackState) -> Result<RackState, String> {
+    if rack.effects.len() > SLOT_COUNT {
+        return Err("The rack supports up to six effects.".into());
+    }
+    while rack.effects.len() < SLOT_COUNT {
+        let mut slot = empty_slot(rack.effects.len());
+        let mut candidate = rack.effects.len();
+        while rack
+            .effects
+            .iter()
+            .any(|existing| existing.slot_id == slot.slot_id)
+        {
+            candidate += 1;
+            slot = empty_slot(candidate);
+        }
+        rack.effects.push(slot);
+    }
+    Ok(rack)
+}
+
+pub fn cache() -> Result<PathBuf, String> {
+    crate::config::app_paths()
+        .map(|paths| paths.root().join("editable"))
+        .map_err(|error| error.to_string())
+}
+
+fn descriptor(cache: &Path, reference: &ImplementationRef) -> Option<PathBuf> {
+    Some(cache.join("effects-meta").join(format!(
+        "{}-{}.json",
+        reference.implementation.to_hex(),
+        reference.environment?.to_hex()
+    )))
+}
+
+pub fn register(cache: &Path, package: &PlayableEffect) -> Result<(), String> {
+    let occurrence = package.occurrence();
+    let reference =
+        ImplementationRef::in_environment(occurrence.implementation, occurrence.environment);
+    let path = descriptor(cache, &reference).expect("a prepared effect has an environment");
+    std::fs::create_dir_all(path.parent().unwrap()).map_err(|error| error.to_string())?;
+    ziddle_file_io::write_json(&path, &occurrence).map_err(|error| error.to_string())
+}
+
+fn lookup(cache: &Path, reference: &ImplementationRef) -> Option<PlayableEffect> {
+    let occurrence: Occurrence = ziddle_file_io::read_json(&descriptor(cache, reference)?).ok()?;
+    if occurrence.implementation != reference.implementation
+        || Some(occurrence.environment) != reference.environment
+    {
+        return None;
+    }
+    let published = ziddle_native_preparation::lookup_effect(
+        cache,
+        occurrence.implementation,
+        occurrence.environment,
+        host_target()?,
+        MODULE_ABI,
+    )
+    .ok()??;
+    admit_prepared(&occurrence, &published).ok()
+}
+
+pub(crate) fn resolve_cached(discovery: &mut PackageDiscovery, rack: &RackState) {
+    let Ok(cache) = cache() else {
+        return;
+    };
+    for effect in &rack.effects {
+        if package_for_state_effect(discovery, effect).is_some() {
+            continue;
+        }
+        let Some(reference) = effect
+            .selection
+            .as_ref()
+            .and_then(|selection| selection.resolved())
+        else {
+            continue;
+        };
+        if let Some(package) = lookup(&cache, reference) {
+            discovery.effects.push(package);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn expands_saved_racks_without_moving_their_slots() {
+        let mut rack = RackState::default();
+        let mut original_slot = empty_slot(0);
+        original_slot.enabled = true;
+        rack.effects.push(original_slot.clone());
+
+        let rack = admit(rack).unwrap();
+        assert_eq!(rack.effects.len(), 6);
+        assert_eq!(rack.effects[0], original_slot);
+        assert!(rack.effects[1..].iter().all(EffectState::is_empty));
+    }
+
+    #[test]
+    fn rejects_a_seventh_slot() {
+        let rack = RackState {
+            effects: (0..7).map(empty_slot).collect(),
+            ..RackState::default()
+        };
+        assert!(admit(rack).is_err());
+    }
+}
