+struct Factory;
+struct Window(HWND);
+
+impl EditorFactory for Factory {
+    fn size(&self, _: Option<isize>) -> (u32, u32) {
+        (WIDTH, HEIGHT)
+    }
+
+    fn open(
+        &self,
+        parent: isize,
+        discovery: PackageDiscovery,
+        _: RackState,
+        state: StateSource,
+        action: ActionSink,
+    ) -> Result<Box<dyn EditorWindow>, String> {
+        unsafe {
+            let instance = module()?;
+            let class = wide("ZezoMultiStompRackEditor");
+            let definition = WNDCLASSW {
+                lpfnWndProc: Some(window_proc),
+                hInstance: instance,
+                hCursor: LoadCursorW(null_mut(), IDC_ARROW),
+                lpszClassName: class.as_ptr(),
+                ..std::mem::zeroed()
+            };
+            RegisterClassW(&definition);
+            let hwnd = CreateWindowExW(
+                0,
+                class.as_ptr(),
+                null(),
+                WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN,
+                0,
+                0,
+                WIDTH as i32,
+                HEIGHT as i32,
+                parent as HWND,
+                null_mut(),
+                instance,
+                null(),
+            );
+            if hwnd.is_null() {
+                return Err(std::io::Error::last_os_error().to_string());
+            }
+            let editor = Rc::new(RefCell::new(Editor::new(
+                hwnd, instance, discovery, state, action,
+            )));
+            SetWindowLongPtrW(hwnd, GWLP_USERDATA, Rc::into_raw(editor) as isize);
+            if SetTimer(hwnd, TIMER, 120, None) == 0 {
+                DestroyWindow(hwnd);
+                return Err("Could not start the rack editor timer.".into());
+            }
+            InvalidateRect(hwnd, null(), 1);
+            Ok(Box::new(Window(hwnd)))
+        }
+    }
+}
+
+impl EditorWindow for Window {
+    fn close(self: Box<Self>) {
+        unsafe {
+            DestroyWindow(self.0);
+        }
+    }
+
+    fn show(&self) -> Result<(), String> {
+        unsafe {
+            ShowWindow(self.0, SW_SHOW);
+        }
+        Ok(())
+    }
+
+    fn hide(&self) -> Result<(), String> {
+        unsafe {
+            ShowWindow(self.0, SW_HIDE);
+        }
+        Ok(())
+    }
+}
