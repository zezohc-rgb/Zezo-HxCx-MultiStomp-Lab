+use std::{collections::BTreeMap, path::Path};
+use ziddle_documents::{era::FirmwareEra, ArtifactId, CancellationToken};
+use ziddle_effect_catalog::CatalogEntry;
+use ziddle_effect_containers::{effect::execution::ExecutionIdentity, zdl::ZdlInfo};
+use ziddle_library_import::FirmwareInput;
+use ziddle_native_builder::{HostCompiler, NativePreparer};
+use ziddle_native_preparation::PreparationOutcome;
+use ziddle_rack_engine::{editable, package::*};
+
+fn input(path: &Path, limit: u64) -> Result<Vec<u8>, String> {
+    use std::io::Read;
+    let mut data = Vec::new();
+    std::fs::File::open(path)
+        .and_then(|file| file.take(limit + 1).read_to_end(&mut data))
+        .map_err(|error| format!("{}: {error}", path.display()))?;
+    if data.len() as u64 > limit {
+        return Err(format!("{} exceeds the file size limit.", path.display()));
+    }
+    Ok(data)
+}
+
+fn complete_from_firmware<'a>(
+    truncated: &[u8],
+    files: &'a BTreeMap<String, Vec<u8>>,
+) -> Option<&'a [u8]> {
+    let info = ZdlInfo::parse(truncated).ok()?;
+    let length = info.elf_offset.checked_add(info.size?.declared_elf_size)?;
+    if length <= truncated.len() {
+        return None;
+    }
+    let mut matches = files
+        .values()
+        .map(Vec::as_slice)
+        .filter(|candidate| candidate.len() == length && candidate.starts_with(truncated));
+    let complete = matches.next()?;
+    // Multiple copies of the same firmware entry are harmless, but a prefix
+    // shared by different complete files does not establish an identity.
+    matches.all(|candidate| candidate == complete).then_some(complete)
+}
+
+pub fn run(
+    effect: &Path,
+    firmware: &Path,
+    zig: &Path,
+    cancel: &CancellationToken,
+    progress: impl FnMut(ziddle_native_preparation::PreparationProgress),
+) -> Result<PlayableEffect, String> {
+    let filename = |path: &Path| {
+        path.file_name()
+            .map(|name| name.to_string_lossy().into_owned())
+            .ok_or_else(|| "The selected path has no file name.".to_owned())
+    };
+    let name = filename(effect)?;
+    let carrier = input(effect, 16 * 1024 * 1024)?;
+    let firmware = FirmwareInput::read(&input(firmware, 128 * 1024 * 1024)?, &filename(firmware)?)
+        .map_err(|error| error.to_string())?;
+    let (entry, carrier) = match CatalogEntry::from_bytes(effect, &carrier, &name) {
+        Ok(entry) => (entry, carrier.as_slice()),
+        Err(error) => {
+            let complete =
+                complete_from_firmware(&carrier, &firmware.files).ok_or_else(|| error.to_string())?;
+            let entry =
+                CatalogEntry::from_bytes(effect, complete, &name).map_err(|error| error.to_string())?;
+            (entry, complete)
+        }
+    };
+    if entry.era != FirmwareEra::Zdl {
+        return Err("Choose a Zoom ZDL effect.".into());
+    }
+    let companion = firmware.companion().map_err(|error| error.to_string())?;
+    let compiler = HostCompiler::zig(zig).map_err(|error| error.to_string())?;
+    let cache = editable::cache()?;
+    let workspace =
+        ziddle_rack_engine::preparation::client::allocate_workspace(&cache.join("work"))
+            .map_err(|error| error.to_string())?;
+    let result = (|| {
+        let preparer =
+            NativePreparer::new(compiler, &cache, &workspace).map_err(|error| error.to_string())?;
+        let preparation = preparer
+            .resolve(&name, carrier, companion, &firmware.program, None)
+            .map_err(|error| error.to_string())?;
+        let reference = &preparation.request().input.implementation;
+        let environment = reference
+            .environment
+            .ok_or("The firmware environment is unknown.")?;
+        let execution = ExecutionIdentity::of(carrier).map_err(|error| error.to_string())?;
+        let occurrence = Occurrence {
+            id: native_effect_occurrence_id(entry.era, reference.implementation, environment),
+            name: entry.name,
+            implementation: reference.implementation,
+            environment,
+            group: ExecutionGroup {
+                execution,
+                companion: companion
+                    .filter(|_| execution.needs_library())
+                    .map(ArtifactId::of),
+            },
+            category: entry.category,
+            dsp_load: entry.dsp_load,
+            models: entry.models,
+        };
+        let published = match preparer.run(&preparation, cancel, progress) {
