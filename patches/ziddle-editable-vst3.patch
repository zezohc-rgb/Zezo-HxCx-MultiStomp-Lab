+    unsafe fn refresh(&mut self) {
+        let rack = (self.state)();
+        if self.rendered.as_ref() == Some(&rack) {
+            return;
+        }
+        if let Ok(discovery) = PackageDiscovery::for_plugin(&rack) {
+            self.discovery = discovery;
+        }
+        let mut total = 0.0;
+        let mut unknown = 0;
+        for (index, card) in self.cards.iter().enumerate() {
+            let effect = rack.effects.get(index).filter(|effect| !effect.is_empty());
+            let package =
+                effect.and_then(|effect| package_for_state_effect(&self.discovery, effect));
+            let enabled = effect.is_some_and(|effect| effect.enabled);
+            let cost = package
+                .and_then(|package| package.dsp_load)
+                .filter(|load| load.is_finite() && *load >= 0.0);
+            if effect.is_some() {
+                if let Some(cost) = cost {
+                    total += cost;
+                } else {
+                    unknown += 1;
+                }
+            }
+            set_text(
+                card.title,
+                package.map_or(
+                    if effect.is_some() {
+                        "Efeito indisponível"
+                    } else {
+                        "Vazio"
+                    },
+                    |p| &p.display_name,
+                ),
+            );
+            let cost_text = match (effect.is_some(), cost) {
+                (false, _) => "DSP: —".into(),
+                (true, None) => "DSP: indisponível".into(),
+                (true, Some(cost)) => {
+                    format!(
+                        "DSP: {cost:.1} pts{}",
+                        if enabled { "" } else { " (bypass)" }
+                    )
+                }
+            };
+            set_text(card.cost, &cost_text);
+            set_text(card.enable, if enabled { "Bypass" } else { "Ligar" });
+            EnableWindow(card.enable, i32::from(effect.is_some()));
+            EnableWindow(card.remove, i32::from(effect.is_some()));
+            EnableWindow(card.controls, i32::from(effect.is_some()));
+        }
+        let total = pedal_budget_text(total, unknown);
+        set_text(self.meter, &total);
+        self.refresh_parameters(&rack);
+        self.rendered = Some(rack);
+    }
+
+    unsafe fn refresh_parameters(&mut self, rack: &RackState) {
+        let panel = &mut self.panel;
+        panel.parameters = parameter_metadata(&self.discovery, rack)
+            .ok()
+            .into_iter()
+            .flat_map(|metadata| metadata.parameters)
+            .filter(|parameter| {
+                matches!(parameter.kind,
+                ParameterKind::Parameter { row, .. } if row == panel.row)
+            })
+            .collect();
+        let pages = panel.parameters.len().div_ceil(KNOBS_PER_PAGE).max(1);
+        panel.page = panel.page.min(pages - 1);
+        let slot_name = rack
+            .effects
+            .get(panel.row)
+            .and_then(|effect| package_for_state_effect(&self.discovery, effect))
+            .map_or("Vazio", |package| &package.display_name);
+        let page_label = if pages > 1 {
+            format!(" · {}/{}", panel.page + 1, pages)
+        } else {
+            String::new()
+        };
+        set_text(
+            panel.heading,
+            &format!("Slot {} · {slot_name}{page_label}", panel.row + 1),
+        );
+        ShowWindow(panel.previous, if pages > 1 { SW_SHOW } else { SW_HIDE });
+        ShowWindow(panel.next, if pages > 1 { SW_SHOW } else { SW_HIDE });
+        EnableWindow(panel.previous, i32::from(panel.page > 0));
+        EnableWindow(panel.next, i32::from(panel.page + 1 < pages));
+        for (index, knob) in panel.knobs.iter().enumerate() {
+            let parameter = panel.parameters.get(panel.page * KNOBS_PER_PAGE + index);
+            let visible = if parameter.is_some() {
+                SW_SHOW
+            } else {
+                SW_HIDE
+            };
+            ShowWindow(knob.label, visible);
+            ShowWindow(knob.slider, visible);
+            if let Some(parameter) = parameter {
+                let steps = parameter.step_count().unwrap_or(1000).max(1);
+                let value = parameter.kind.read(rack).unwrap_or(parameter.default);
+                let position = (parameter.normalized(value) * f64::from(steps)).round() as isize;
+                SendMessageW(knob.slider, TBM_SETRANGEMAX, 1, steps as isize);
+                SendMessageW(knob.slider, TBM_SETPOS, 1, position);
+                set_text(
+                    knob.label,
+                    &format!("{}: {}", parameter.name, parameter.text(value)),
+                );
+            }
+        }
+    }
+
+    unsafe fn move_parameter(&mut self, slider: HWND) {
+        let Some(index) = self
+            .panel
+            .knobs
+            .iter()
+            .position(|knob| knob.slider == slider)
+        else {
+            return;
+        };
+        let Some(parameter) = self
+            .panel
+            .parameters
+            .get(self.panel.page * KNOBS_PER_PAGE + index)
+        else {
+            return;
+        };
+        let position = SendMessageW(slider, TBM_GETPOS, 0, 0);
+        let steps = parameter.step_count().unwrap_or(1000).max(1);
+        let normalized = (position as f64 / f64::from(steps)).clamp(0.0, 1.0);
+        (self.action)(EditorAction::SetParameter {
+            id: parameter.id,
+            normalized,
+        });
+        self.refresh();
+    }
+
+    unsafe fn replace(&mut self, row: usize, change: impl FnOnce(&mut RackState)) -> bool {
+        let mut rack = (self.state)();
+        while rack.effects.len() < SLOT_COUNT {
+            rack.effects.push(empty_slot(rack.effects.len()));
+        }
+        if row >= rack.effects.len() {
+            return false;
+        }
+        change(&mut rack);
+        (self.action)(EditorAction::ReplaceState(rack.clone()));
+        let installed = (self.state)() == rack;
+        if !installed {
+            set_text(self.status, "O REAPER não aceitou a alteração da cadeia.");
+        }
+        self.refresh();
+        installed
+    }
+
+    unsafe fn command(&mut self, hwnd: HWND, id: usize) {
+        match id {
+            FOLDER => {
+                if let Some(folder) = choose_folder(hwnd) {
+                    self.settings.folder = Some(folder);
+                    self.saved("Pasta ZDL selecionada.");
+                }
+            }
+            FIRMWARE => {
+                self.select_firmware(hwnd);
+            }
+            COMPILER => {
+                self.select_zig(hwnd);
+            }
+            id if (CONTROLS..CONTROLS + SLOT_COUNT).contains(&id) => {
+                self.panel.row = id - CONTROLS;
+                self.panel.page = 0;
+                self.rendered = None;
+                self.refresh();
+            }
+            PREVIOUS | NEXT => {
+                self.panel.page = if id == NEXT {
+                    self.panel.page + 1
+                } else {
+                    self.panel.page.saturating_sub(1)
+                };
+                self.rendered = None;
+                self.refresh();
+            }
+            id if (LOAD..LOAD + SLOT_COUNT).contains(&id) => self.load(hwnd, id - LOAD),
+            id if (ENABLE..ENABLE + SLOT_COUNT).contains(&id) => {
+                let row = id - ENABLE;
+                self.replace(row, |rack| {
+                    rack.effects[row].enabled = !rack.effects[row].enabled
+                });
+            }
+            id if (REMOVE..REMOVE + SLOT_COUNT).contains(&id) => {
+                let row = id - REMOVE;
+                self.replace(row, |rack| {
+                    let slot_id = rack.effects[row].slot_id;
+                    rack.effects[row] = empty_slot(row);
+                    rack.effects[row].slot_id = slot_id;
+                });
+            }
+            _ => (),
+        }
+    }
+
+    unsafe fn saved(&self, status: &str) {
+        match self.settings.save() {
+            Ok(()) => set_text(self.status, status),
+            Err(error) => set_text(self.status, &format!("Preferências não salvas: {error}")),
+        }
+    }
+
+    unsafe fn select_firmware(&mut self, hwnd: HWND) -> Option<PathBuf> {
+        let path = choose(hwnd, "Firmware Zoom (*.exe;*.bin)\0*.exe;*.bin\0", None)?;
+        self.settings.firmware = Some(path.clone());
+        self.saved("Firmware selecionado.");
+        Some(path)
+    }
+
+    unsafe fn select_zig(&mut self, hwnd: HWND) -> Option<PathBuf> {
+        let path = choose(
+            hwnd,
+            "Zig (zig.exe)\0zig.exe\0Executáveis (*.exe)\0*.exe\0",
+            None,
+        )?;
+        self.settings.zig = Some(path.clone());
+        self.saved("Zig selecionado.");
+        Some(path)
+    }
+
+    unsafe fn load(&mut self, hwnd: HWND, row: usize) {
+        if self.job.is_some() {
+            return;
+        }
+        let Some(effect) = choose(
+            hwnd,
+            "Efeitos Zoom (*.ZDL)\0*.ZDL\0",
+            self.settings.folder.as_deref(),
+        ) else {
+            return;
+        };
+        if let Some(folder) = effect.parent() {
+            if self.settings.folder.as_deref() != Some(folder) {
+                self.settings.folder = Some(folder.to_path_buf());
+                self.saved("Pasta ZDL selecionada.");
+            }
+        }
+        if self.settings.firmware.is_none() {
+            match prepare::implementation(&effect) {
+                Ok(implementation) => {
+                    let mut candidates = self
+                        .discovery
+                        .effects
+                        .iter()
+                        .filter(|package| package.source_implementation == implementation);
+                    if let (Some(package), None) = (candidates.next(), candidates.next()) {
+                        self.install_effect(row, package.clone());
+                        return;
+                    }
+                }
+                Err(error) => {
+                    set_text(self.status, &error);
+                    return;
+                }
+            }
+        }
+        let firmware = self
+            .settings
+            .firmware
+            .clone()
+            .filter(|path| path.is_file())
+            .or_else(|| self.select_firmware(hwnd));
+        let Some(firmware) = firmware else {
+            set_text(
+                self.status,
+                "Selecione o firmware compatível para preparar este ZDL.",
+            );
+            return;
+        };
+        let zig = self
+            .settings
+            .zig
+            .clone()
+            .filter(|path| path.is_file())
+            .or_else(|| self.select_zig(hwnd));
+        let Some(zig) = zig else {
+            set_text(
+                self.status,
+                "Selecione o Zig 0.16.0 para preparar este ZDL.",
+            );
+            return;
+        };
+        let cancel = CancellationToken::default();
+        let job_cancel = cancel.clone();
+        let name = effect
+            .file_name()
+            .unwrap_or(effect.as_os_str())
+            .to_string_lossy()
+            .into_owned();
+        let (sender, updates) = mpsc::channel();
+        let thread = std::thread::spawn(move || {
+            let result = prepare::run(&effect, &firmware, &zig, &job_cancel, |progress| {
+                let _ = sender.send(Event::Progress(progress.message));
+            });
+            let _ = sender.send(Event::Done(result.map(Box::new)));
+        });
+        self.job = Some(Job {
+            row,
+            name,
+            updates,
+            thread,
+            cancel,
+        });
+        for card in &self.cards {
+            EnableWindow(card.load, 0);
+        }
+        set_text(self.status, "Preparando e verificando o efeito…");
+    }
+
+    unsafe fn tick(&mut self) {
+        self.refresh();
+        let Some(job) = &self.job else {
+            return;
+        };
+        let result = loop {
+            match job.updates.try_recv() {
+                Ok(Event::Progress(text)) => set_text(self.status, &text),
+                Ok(Event::Done(result)) => break result,
+                Err(mpsc::TryRecvError::Empty) => return,
+                Err(mpsc::TryRecvError::Disconnected) => {
+                    break Err("A preparação foi interrompida.".into())
+                }
+            }
+        };
+        let job = self.job.take().unwrap();
+        let _ = job.thread.join();
+        for card in &self.cards {
+            EnableWindow(card.load, 1);
+        }
+        match result {
+            Ok(package) => self.install_effect(job.row, *package),
+            Err(error) => {
+                set_text(self.status, &error);
+                MessageBoxW(
+                    self.status,
+                    wide(&error).as_ptr(),
+                    wide(&format!("{} — Preparação", job.name)).as_ptr(),
+                    MB_OK | MB_ICONERROR,
+                );
+            }
+        }
+    }
+    unsafe fn install_effect(&mut self, row: usize, package: PlayableEffect) {
+        let name = package.display_name.clone();
+        let mut effect = RackState::from_packages(std::slice::from_ref(&package))
+            .effects
+            .remove(0);
+        if !self
+            .discovery
+            .effects
+            .iter()
+            .any(|old| old.id == package.id)
+        {
+            self.discovery.effects.push(package);
+        }
+        self.rendered = None;
+        self.panel.row = row;
+        self.panel.page = 0;
+        if self.replace(row, |rack| {
+            effect.slot_id = rack.effects[row].slot_id;
+            rack.effects[row] = effect;
+        }) {
+            set_text(
+                self.status,
+                &format!("{} carregado no slot {}.", name, row + 1),
+            );
+        }
+    }
+}
+
+impl Drop for Editor {
+    fn drop(&mut self) {
+        if let Some(job) = self.job.take() {
+            job.cancel.cancel();
+            let _ = job.thread.join();
+        }
+        unsafe {
+            for font in self.fonts {
+                DeleteObject(font);
+            }
+        }
+    }
+}
