+use ziddle_rack_engine::editor_hook::*;
+use ziddle_rack_engine::package::{PackageDiscovery, PlayableEffect};
+use ziddle_rack_engine::rack_state::{package_for_state_effect, RackState};
+
+const WIDTH: u32 = 834;
+const HEIGHT: u32 = 477;
+const TIMER: usize = 1;
+const FIRMWARE: usize = 10;
+const COMPILER: usize = 11;
+const LOAD: usize = 20;
+const ENABLE: usize = 30;
+const REMOVE: usize = 40;
+const BACKGROUND: u32 = 0x241812;
+const FOREGROUND: u32 = 0xf3ede4;
+const ACCENT: u32 = 0x7edc70;
+
+pub fn install() {
+    static INSTALLED: OnceLock<()> = OnceLock::new();
+    INSTALLED.get_or_init(|| {
+        let _ = ziddle_rack_engine::editor_hook::install(Arc::new(Factory));
+    });
+}
+
+struct Factory;
+struct Window(HWND);
+
+impl EditorFactory for Factory {
+    fn size(&self, _: Option<isize>) -> (u32, u32) {
+        (WIDTH, HEIGHT)
+    }
+
+    fn open(
+        &self,
+        parent: isize,
+        discovery: PackageDiscovery,
+        _: RackState,
+        state: StateSource,
+        action: ActionSink,
+    ) -> Result<Box<dyn EditorWindow>, String> {
+        unsafe {
+            let instance = module()?;
+            let class = wide("ZezoMultiStompRackEditor");
+            let definition = WNDCLASSW {
+                lpfnWndProc: Some(window_proc),
+                hInstance: instance,
+                hCursor: LoadCursorW(null_mut(), IDC_ARROW),
+                lpszClassName: class.as_ptr(),
+                ..std::mem::zeroed()
+            };
+            RegisterClassW(&definition);
+            let hwnd = CreateWindowExW(
+                0,
+                class.as_ptr(),
+                null(),
+                WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN,
+                0,
+                0,
+                WIDTH as i32,
+                HEIGHT as i32,
+                parent as HWND,
+                null_mut(),
+                instance,
+                null(),
+            );
+            if hwnd.is_null() {
+                return Err(std::io::Error::last_os_error().to_string());
+            }
+            let editor = Rc::new(RefCell::new(Editor::new(
+                hwnd, instance, discovery, state, action,
+            )));
+            SetWindowLongPtrW(hwnd, GWLP_USERDATA, Rc::into_raw(editor) as isize);
+            if SetTimer(hwnd, TIMER, 120, None) == 0 {
+                DestroyWindow(hwnd);
+                return Err("Could not start the rack editor timer.".into());
+            }
+            InvalidateRect(hwnd, null(), 1);
+            Ok(Box::new(Window(hwnd)))
+        }
+    }
+}
+
+impl EditorWindow for Window {
+    fn close(self: Box<Self>) {
+        unsafe {
+            DestroyWindow(self.0);
+        }
+    }
+
+    fn show(&self) -> Result<(), String> {
+        unsafe {
+            ShowWindow(self.0, SW_SHOW);
+        }
+        Ok(())
+    }
+
+    fn hide(&self) -> Result<(), String> {
+        unsafe {
+            ShowWindow(self.0, SW_HIDE);
+        }
+        Ok(())
+    }
+}
+
+struct Card {
+    title: HWND,
+    cost: HWND,
+    load: HWND,
+    enable: HWND,
+    remove: HWND,
+}
+
+enum Event {
+    Progress(String),
+    Done(Result<Box<PlayableEffect>, String>),
+}
+
+struct Job {
+    row: usize,
+    updates: mpsc::Receiver<Event>,
+    thread: JoinHandle<()>,
+    cancel: CancellationToken,
+}
+
+struct Editor {
+    discovery: PackageDiscovery,
+    state: StateSource,
+    action: ActionSink,
+    cards: Vec<Card>,
+    status: HWND,
+    meter: HWND,
+    firmware: Option<PathBuf>,
+    zig: Option<PathBuf>,
+    job: Option<Job>,
+    rendered: Option<RackState>,
+    fonts: [HFONT; 3],
+}
+
+impl Editor {
+    unsafe fn new(
+        hwnd: HWND,
+        instance: HINSTANCE,
+        discovery: PackageDiscovery,
+        state: StateSource,
+        action: ActionSink,
+    ) -> Self {
+        let fonts = [font(30, 700), font(19, 600), font(15, 400)];
+        let label = |name: &str, x, y, w, h, style| {
+            control(
+                hwnd,
+                instance,
+                "STATIC",
+                name,
+                0,
+                [x, y, w, h],
+                style,
+                fonts[2],
+            )
+        };
+        let button = |name: &str, id, x, y, w| {
+            control(
+                hwnd,
+                instance,
+                "BUTTON",
+                name,
+                id,
+                [x, y, w, 29],
+                WS_TABSTOP,
+                fonts[2],
+            )
+        };
+        let title = label("ZEZO MULTISTOMP", 24, 16, 450, 38, 0);
+        SendMessageW(title, WM_SETFONT, fonts[0] as usize, 1);
+        let meter = label("", 24, 67, 500, 25, 0);
+        SendMessageW(meter, WM_SETFONT, fonts[1] as usize, 1);
+        button("Firmware...", FIRMWARE, 534, 62, 132);
+        button("Zig...", COMPILER, 680, 62, 130);
+        let mut cards = Vec::with_capacity(SLOT_COUNT);
+        for index in 0..SLOT_COUNT {
+            let x = 24 + (index % 3) as i32 * 267;
+            let y = 105 + (index / 3) as i32 * 154;
+            label(&format!("SLOT {}", index + 1), x + 12, y + 11, 226, 20, 0);
+            let title = label("", x + 12, y + 35, 226, 25, SS_ENDELLIPSIS);
+            SendMessageW(title, WM_SETFONT, fonts[1] as usize, 1);
+            cards.push(Card {
+                title,
+                cost: label("", x + 12, y + 66, 226, 21, 0),
+                load: button("Carregar ZDL", LOAD + index, x + 12, y + 99, 92),
+                enable: button("Bypass", ENABLE + index, x + 110, y + 99, 59),
+                remove: button("Remover", REMOVE + index, x + 175, y + 99, 65),
+            });
+        }
+        let status = label(
+            "Para carregar um ZDL, selecione o firmware do pedal e o Zig 0.16.0.",
+            24,
+            426,
+            786,
+            38,
+            SS_ENDELLIPSIS,
+        );
+        let mut editor = Self {
+            discovery,
+            state,
+            action,
+            cards,
+            status,
+            meter,
+            firmware: None,
+            zig: None,
+            job: None,
+            rendered: None,
+            fonts,
+        };
+        editor.refresh();
+        editor
+    }
+
+    unsafe fn refresh(&mut self) {
+        let rack = (self.state)();
+        if self.rendered.as_ref() == Some(&rack) {
+            return;
+        }
+        if let Ok(discovery) = PackageDiscovery::for_plugin(&rack) {
+            self.discovery = discovery;
+        }
+        let mut total = 0.0;
+        let mut unknown = 0;
+        for (index, card) in self.cards.iter().enumerate() {
+            let effect = rack.effects.get(index).filter(|effect| !effect.is_empty());
+            let package =
+                effect.and_then(|effect| package_for_state_effect(&self.discovery, effect));
+            let enabled = effect.is_some_and(|effect| effect.enabled);
+            let cost = package
+                .and_then(|package| package.dsp_load)
+                .filter(|load| load.is_finite() && *load >= 0.0);
+            if enabled && !rack.bypass {
+                if let Some(cost) = cost {
+                    total += cost;
+                } else {
+                    unknown += 1;
+                }
+            }
+            set_text(
+                card.title,
+                package.map_or(
+                    if effect.is_some() {
+                        "Efeito indisponível"
+                    } else {
+                        "Vazio"
+                    },
+                    |p| &p.display_name,
+                ),
+            );
+            let cost_text = match (effect.is_some(), cost) {
+                (false, _) => "DSP: —".into(),
+                (true, None) => "DSP: indisponível".into(),
+                (true, Some(cost)) => {
+                    format!("DSP: {cost:.1}%{}", if enabled { "" } else { " (bypass)" })
+                }
+            };
+            set_text(card.cost, &cost_text);
+            set_text(card.enable, if enabled { "Bypass" } else { "Ligar" });
+            EnableWindow(card.enable, i32::from(effect.is_some()));
+            EnableWindow(card.remove, i32::from(effect.is_some()));
+        }
+        let total = if unknown == 0 {
+            format!("DSP da cadeia (pedal): {total:.1}%")
+        } else {
+            format!("DSP conhecido: {total:.1}%  ·  {unknown} sem dados")
+        };
+        set_text(self.meter, &total);
+        self.rendered = Some(rack);
+    }
+
+    unsafe fn replace(&mut self, row: usize, change: impl FnOnce(&mut RackState)) -> bool {
+        let mut rack = (self.state)();
+        while rack.effects.len() < SLOT_COUNT {
+            rack.effects.push(empty_slot(rack.effects.len()));
+        }
+        if row >= rack.effects.len() {
+            return false;
+        }
+        change(&mut rack);
+        (self.action)(EditorAction::ReplaceState(rack.clone()));
+        let installed = (self.state)() == rack;
+        if !installed {
+            set_text(self.status, "O REAPER não aceitou a alteração da cadeia.");
+        }
+        self.refresh();
+        installed
+    }
+
+    unsafe fn command(&mut self, hwnd: HWND, id: usize) {
+        match id {
+            FIRMWARE => {
+                if let Some(path) = choose(hwnd, "Firmware Zoom (*.exe;*.bin)\0*.exe;*.bin\0") {
+                    set_text(self.status, &format!("Firmware: {}", path.display()));
+                    self.firmware = Some(path);
+                }
+            }
+            COMPILER => {
+                if let Some(path) =
+                    choose(hwnd, "Zig (zig.exe)\0zig.exe\0Executáveis (*.exe)\0*.exe\0")
+                {
+                    set_text(self.status, &format!("Zig: {}", path.display()));
+                    self.zig = Some(path);
+                }
+            }
+            id if (LOAD..LOAD + SLOT_COUNT).contains(&id) => self.load(hwnd, id - LOAD),
+            id if (ENABLE..ENABLE + SLOT_COUNT).contains(&id) => {
+                let row = id - ENABLE;
+                self.replace(row, |rack| {
+                    rack.effects[row].enabled = !rack.effects[row].enabled
+                });
+            }
+            id if (REMOVE..REMOVE + SLOT_COUNT).contains(&id) => {
+                let row = id - REMOVE;
+                self.replace(row, |rack| {
+                    let slot_id = rack.effects[row].slot_id;
+                    rack.effects[row] = empty_slot(row);
+                    rack.effects[row].slot_id = slot_id;
+                });
+            }
+            _ => (),
+        }
+    }
+
+    unsafe fn load(&mut self, hwnd: HWND, row: usize) {
+        if self.job.is_some() {
+            return;
+        }
+        let Some(firmware) = self.firmware.clone() else {
+            set_text(
+                self.status,
+                "Selecione o firmware executável do seu pedal primeiro.",
+            );
+            return;
+        };
+        let Some(zig) = self.zig.clone() else {
+            set_text(self.status, "Selecione zig.exe da versão 0.16.0 primeiro.");
+            return;
+        };
+        let Some(effect) = choose(hwnd, "Efeitos Zoom (*.ZDL)\0*.ZDL\0") else {
+            return;
+        };
+        let cancel = CancellationToken::default();
+        let job_cancel = cancel.clone();
+        let (sender, updates) = mpsc::channel();
+        let thread = std::thread::spawn(move || {
+            let result = prepare::run(&effect, &firmware, &zig, &job_cancel, |progress| {
+                let _ = sender.send(Event::Progress(progress.message));
+            });
+            let _ = sender.send(Event::Done(result.map(Box::new)));
+        });
+        self.job = Some(Job {
+            row,
+            updates,
+            thread,
+            cancel,
+        });
+        for card in &self.cards {
+            EnableWindow(card.load, 0);
+        }
+        set_text(self.status, "Preparando e verificando o efeito…");
+    }
+
+    unsafe fn tick(&mut self) {
+        self.refresh();
+        let Some(job) = &self.job else {
+            return;
+        };
+        let result = loop {
+            match job.updates.try_recv() {
+                Ok(Event::Progress(text)) => set_text(self.status, &text),
+                Ok(Event::Done(result)) => break result,
+                Err(mpsc::TryRecvError::Empty) => return,
+                Err(mpsc::TryRecvError::Disconnected) => {
+                    break Err("A preparação foi interrompida.".into())
+                }
+            }
+        };
+        let job = self.job.take().unwrap();
+        let _ = job.thread.join();
+        for card in &self.cards {
+            EnableWindow(card.load, 1);
+        }
+        match result {
+            Ok(package) => {
+                let name = package.display_name.clone();
+                let mut effect = RackState::from_packages(std::slice::from_ref(&*package))
+                    .effects
+                    .remove(0);
+                if !self
+                    .discovery
+                    .effects
+                    .iter()
+                    .any(|old| old.id == package.id)
+                {
+                    self.discovery.effects.push(*package);
+                }
+                self.rendered = None;
+                if self.replace(job.row, |rack| {
+                    effect.slot_id = rack.effects[job.row].slot_id;
+                    rack.effects[job.row] = effect;
+                }) {
+                    set_text(
+                        self.status,
+                        &format!("{} carregado no slot {}.", name, job.row + 1),
+                    );
+                }
+            }
+            Err(error) => {
+                set_text(self.status, &error);
+                MessageBoxW(
+                    self.status,
+                    wide(&error).as_ptr(),
+                    wide("CE2Soul — Preparação").as_ptr(),
+                    MB_OK | MB_ICONERROR,
+                );
+            }
+        }
+    }
+}
+
+impl Drop for Editor {
+    fn drop(&mut self) {
+        if let Some(job) = self.job.take() {
+            job.cancel.cancel();
+            let _ = job.thread.join();
+        }
+        unsafe {
+            for font in self.fonts {
+                DeleteObject(font);
+            }
+        }
+    }
+}
+
+unsafe extern "system" fn window_proc(hwnd: HWND, msg: u32, w: WPARAM, l: LPARAM) -> LRESULT {
+    ziddle_rack_engine::host_support::guard(0, || {
+        let pointer = GetWindowLongPtrW(hwnd, GWLP_USERDATA) as *const RefCell<Editor>;
+        if !pointer.is_null() {
+            Rc::increment_strong_count(pointer);
+            let state = Rc::from_raw(pointer);
+            match msg {
+                WM_NCDESTROY => {
+                    SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0);
+                    KillTimer(hwnd, TIMER);
+                    drop(Rc::from_raw(pointer));
+                }
+                WM_CTLCOLORSTATIC => {
+                    let is_meter = state
+                        .try_borrow()
+                        .is_ok_and(|editor| l as HWND == editor.meter);
+                    SetTextColor(w as HDC, if is_meter { ACCENT } else { FOREGROUND });
+                    SetBkColor(w as HDC, BACKGROUND);
+                    SetDCBrushColor(w as HDC, BACKGROUND);
+                    return GetStockObject(DC_BRUSH) as LRESULT;
+                }
+                WM_ERASEBKGND => {
+                    let mut rect = std::mem::zeroed();
+                    GetClientRect(hwnd, &mut rect);
+                    let background = GetStockObject(DC_BRUSH);
+                    SetDCBrushColor(w as HDC, BACKGROUND);
+                    FillRect(w as HDC, &rect, background);
+                    let outline = CreateSolidBrush(0x5e4939);
+                    for index in 0..SLOT_COUNT {
+                        let left = 24 + (index % 3) as i32 * 267;
+                        let top = 105 + (index / 3) as i32 * 154;
+                        let card = windows_sys::Win32::Foundation::RECT {
+                            left,
+                            top,
+                            right: left + 252,
+                            bottom: top + 141,
+                        };
+                        FrameRect(w as HDC, &card, outline);
+                    }
+                    DeleteObject(outline);
+                    return 1;
+                }
+                WM_COMMAND if (w >> 16) == 0 => {
+                    if let Ok(mut editor) = state.try_borrow_mut() {
+                        editor.command(hwnd, w & 0xffff);
+                    }
+                    return 0;
+                }
+                WM_TIMER if w == TIMER => {
+                    if let Ok(mut editor) = state.try_borrow_mut() {
+                        editor.tick();
+                    }
+                    return 0;
+                }
+                _ => (),
+            }
+        }
+        DefWindowProcW(hwnd, msg, w, l)
+    })
+}
+
+fn wide(text: &str) -> Vec<u16> {
+    text.encode_utf16().chain(Some(0)).collect()
+}
+
+unsafe fn set_text(window: HWND, text: &str) {
+    SetWindowTextW(window, wide(text).as_ptr());
+}
+
+unsafe fn font(size: i32, weight: i32) -> HFONT {
+    CreateFontW(
+        -size,
+        0,
+        0,
+        0,
+        weight,
+        0,
+        0,
+        0,
+        1,
+        0,
+        0,
+        5,
+        0,
+        wide("Segoe UI").as_ptr(),
+    )
+}
+
+unsafe fn control(
+    parent: HWND,
+    instance: HINSTANCE,
+    class: &str,
+    text: &str,
+    id: usize,
+    [x, y, width, height]: [i32; 4],
+    style: u32,
+    font: HFONT,
+) -> HWND {
+    let child = CreateWindowExW(
+        0,
+        wide(class).as_ptr(),
+        wide(text).as_ptr(),
+        WS_CHILD | WS_VISIBLE | style,
+        x,
+        y,
+        width,
+        height,
+        parent,
+        id as HMENU,
+        instance,
+        null::<c_void>(),
+    );
+    SendMessageW(child, WM_SETFONT, font as usize, 1);
+    child
+}
+
+unsafe fn module() -> Result<HINSTANCE, String> {
+    let mut instance = null_mut();
+    if GetModuleHandleExW(6, module as *const () as *const u16, &mut instance) == 0 {
+        return Err(std::io::Error::last_os_error().to_string());
+    }
+    Ok(instance)
+}
+
+unsafe fn choose(owner: HWND, filter: &str) -> Option<PathBuf> {
+    let mut filename = [0u16; 32768];
+    let filter = wide(filter);
+    let mut request: OPENFILENAMEW = std::mem::zeroed();
+    request.lStructSize = std::mem::size_of::<OPENFILENAMEW>() as u32;
+    request.hwndOwner = owner;
+    request.lpstrFilter = filter.as_ptr();
+    request.lpstrFile = filename.as_mut_ptr();
+    request.nMaxFile = filename.len() as u32;
+    request.Flags = OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST | OFN_NOCHANGEDIR;
+    if GetOpenFileNameW(&mut request) == 0 {
+        return None;
+    }
+    let end = filename.iter().position(|&word| word == 0)?;
+    Some(std::ffi::OsString::from_wide(&filename[..end]).into())
+}
