+unsafe fn module() -> Result<HINSTANCE, String> {
+    let mut instance = null_mut();
+    if GetModuleHandleExW(6, module as *const () as *const u16, &mut instance) == 0 {
+        return Err(std::io::Error::last_os_error().to_string());
+    }
+    Ok(instance)
+}
+
+unsafe fn choose(owner: HWND, filter: &str, folder: Option<&Path>) -> Option<PathBuf> {
+    let mut filename = [0u16; 32768];
+    let filter = wide(filter);
+    let mut request: OPENFILENAMEW = std::mem::zeroed();
+    request.lStructSize = std::mem::size_of::<OPENFILENAMEW>() as u32;
+    request.hwndOwner = owner;
+    request.lpstrFilter = filter.as_ptr();
+    let initial = folder.filter(|path| path.is_dir()).map(|path| {
+        path.as_os_str()
+            .encode_wide()
+            .chain(Some(0))
+            .collect::<Vec<_>>()
+    });
+    request.lpstrInitialDir = initial.as_ref().map_or(null(), |path| path.as_ptr());
+    request.lpstrFile = filename.as_mut_ptr();
+    request.nMaxFile = filename.len() as u32;
+    request.Flags = OFN_FILEMUSTEXIST | OFN_PATHMUSTEXIST | OFN_NOCHANGEDIR;
+    if GetOpenFileNameW(&mut request) == 0 {
+        return None;
+    }
+    let end = filename.iter().position(|&word| word == 0)?;
+    Some(std::ffi::OsString::from_wide(&filename[..end]).into())
+}
+
+unsafe fn choose_folder(hwnd: HWND) -> Option<PathBuf> {
+    let title = wide("Selecione a pasta dos seus ZDLs");
+    let mut display_name = [0u16; 260];
+    let request = BROWSEINFOW {
+        hwndOwner: hwnd,
+        pszDisplayName: display_name.as_mut_ptr(),
+        lpszTitle: title.as_ptr(),
+        ulFlags: BIF_RETURNONLYFSDIRS,
+        ..std::mem::zeroed()
+    };
+    let item = SHBrowseForFolderW(&request);
+    if item.is_null() {
+        return None;
+    }
+    let mut path = [0u16; 32768];
+    let found =
+        SHGetPathFromIDListEx(item, path.as_mut_ptr(), path.len() as u32, GPFIDL_DEFAULT) != 0;
+    CoTaskMemFree(item.cast());
+    if !found {
+        return None;
+    }
+    let end = path.iter().position(|&unit| unit == 0)?;
+    Some(std::ffi::OsString::from_wide(&path[..end]).into())
+}
+
+fn pedal_budget_text(total: f32, unknown: usize) -> String {
+    if total >= PEDAL_BUDGET {
+        format!("DSP Full · {total:.1} / {PEDAL_BUDGET:.0} pts")
+    } else if unknown > 0 {
+        format!("DSP MS-70CDR · {total:.1}+ / {PEDAL_BUDGET:.0} pts ({unknown} sem dados)")
+    } else {
+        format!("DSP MS-70CDR · {total:.1} / {PEDAL_BUDGET:.0} pts")
+    }
+}
