+unsafe extern "system" fn window_proc(hwnd: HWND, msg: u32, w: WPARAM, l: LPARAM) -> LRESULT {
+    ziddle_rack_engine::host_support::guard(0, || {
+        let pointer = GetWindowLongPtrW(hwnd, GWLP_USERDATA) as *const RefCell<Editor>;
+        if !pointer.is_null() {
+            Rc::increment_strong_count(pointer);
+            let state = Rc::from_raw(pointer);
+            match msg {
+                WM_NCDESTROY => {
+                    SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0);
+                    KillTimer(hwnd, TIMER);
+                    drop(Rc::from_raw(pointer));
+                }
+                WM_CTLCOLORSTATIC => {
+                    let is_meter = state
+                        .try_borrow()
+                        .is_ok_and(|editor| l as HWND == editor.meter);
+                    SetTextColor(w as HDC, if is_meter { ACCENT } else { FOREGROUND });
+                    SetBkColor(w as HDC, BACKGROUND);
+                    SetDCBrushColor(w as HDC, BACKGROUND);
+                    return GetStockObject(DC_BRUSH) as LRESULT;
+                }
+                WM_ERASEBKGND => {
+                    let mut rect = std::mem::zeroed();
+                    GetClientRect(hwnd, &mut rect);
+                    let background = GetStockObject(DC_BRUSH);
+                    SetDCBrushColor(w as HDC, BACKGROUND);
+                    FillRect(w as HDC, &rect, background);
+                    let outline = CreateSolidBrush(0x5e4939);
+                    for index in 0..SLOT_COUNT {
+                        let left = 24 + (index % 3) as i32 * 267;
+                        let top = 105 + (index / 3) as i32 * 154;
+                        let card = windows_sys::Win32::Foundation::RECT {
+                            left,
+                            top,
+                            right: left + 252,
+                            bottom: top + 141,
+                        };
+                        FrameRect(w as HDC, &card, outline);
+                    }
+                    DeleteObject(outline);
+                    return 1;
+                }
+                WM_COMMAND if (w >> 16) == 0 => {
+                    if let Ok(mut editor) = state.try_borrow_mut() {
+                        editor.command(hwnd, w & 0xffff);
+                    }
+                    return 0;
+                }
+                WM_HSCROLL => {
+                    if let Ok(mut editor) = state.try_borrow_mut() {
+                        editor.move_parameter(l as HWND);
+                    }
+                    return 0;
+                }
+                WM_TIMER if w == TIMER => {
+                    if let Ok(mut editor) = state.try_borrow_mut() {
+                        editor.tick();
+                    }
+                    return 0;
+                }
+                _ => (),
+            }
+        }
+        DefWindowProcW(hwnd, msg, w, l)
+    })
+}
+
+fn wide(text: &str) -> Vec<u16> {
+    text.encode_utf16().chain(Some(0)).collect()
+}
+
+unsafe fn set_text(window: HWND, text: &str) {
+    SetWindowTextW(window, wide(text).as_ptr());
+}
+
+unsafe fn font(size: i32, weight: i32) -> HFONT {
+    CreateFontW(
+        -size,
+        0,
+        0,
+        0,
+        weight,
+        0,
+        0,
+        0,
+        1,
+        0,
+        0,
+        5,
+        0,
+        wide("Segoe UI").as_ptr(),
+    )
+}
+
+unsafe fn control(
+    parent: HWND,
+    instance: HINSTANCE,
+    class: &str,
+    text: &str,
+    id: usize,
+    [x, y, width, height]: [i32; 4],
+    style: u32,
+    font: HFONT,
+) -> HWND {
+    let child = CreateWindowExW(
+        0,
+        wide(class).as_ptr(),
